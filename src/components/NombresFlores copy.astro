---
// NombresFlores.astro
---

<section id="seccion-nombres" class="relative w-full overflow-hidden">

    <!-- FLOR DECORATIVA DERECHA -->
    <img
        src="/imagenes/florcostado.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 right-0 w-40 pointer-events-none select-none opacity-30 scale-x-[-1] -translate-y-1/2 z-[-1]"
    />
    <!-- FOTO PRINCIPAL DE LOS NOVIOS -->
    <div id="foto-container" class="relative w-full overflow-hidden">
        <img
            id="foto-novios"
            src="/imagenes/principal.png"
            alt="Alfredo y Zianna"
            class="block w-full h-auto"
        />
    </div>

    <!-- TEXTO: ¡NOS CASAMOS! + NOMBRES + ANILLOS -->
    <div
        id="texto-nombres"
        class="text-center px-6 pt-4 pb-2 flex flex-col items-center"
    >
        <p
            class="font-cormorant uppercase tracking-[0.35em] text-base font-semibold"
            style="color: #B09372;"
        >
            ¡NOS CASAMOS!
        </p>

        <h2
            class="font-romantic mt-7 leading-tight whitespace-nowrap"
            style="color: #557E30; font-size: 2.1rem;"
        >
            Alfredo y Zianna
        </h2>

        <!-- Anillo con barras beige horizontales a los costados -->
        <div
            class="flex items-center justify-center gap-3 mt-5 w-full max-w-[15rem]"
        >
            <span class="h-px flex-1 bg-[#D8C9B0] opacity-70"></span>
            <img
                src="/imagenes/anillo.png"
                alt="Anillos de boda"
                class="w-12 anillo-salvia flex-shrink-0"
            />
            <span class="h-px flex-1 bg-[#D8C9B0] opacity-70"></span>
        </div>
    </div>
</section>

<!-- BOTÓN FLOTANTE PLAY/PAUSE -->
<button
    id="btn-audio-control"
    aria-label="Controlar música"
    class="fixed bottom-6 right-6 z-[9999] w-12 h-12 rounded-full shadow-lg
           flex items-center justify-center
           transition-all duration-300 hover:scale-110 active:scale-95"
    style="opacity: 0; pointer-events: none; background-color: #f4f0e6; border: 1.5px solid #41612A;"
>
    <svg
        id="icono-pause"
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="#41612A"
    >
        <rect x="6" y="4" width="4" height="16" rx="1"></rect>
        <rect x="14" y="4" width="4" height="16" rx="1"></rect>
    </svg>
    <svg
        id="icono-play"
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 hidden"
        viewBox="0 0 24 24"
        fill="#41612A"
    >
        <path d="M8 5v14l11-7z"></path>
    </svg>
</button>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // FOTO - aparece con leve zoom out
        gsap.fromTo(
            "#foto-novios",
            { opacity: 0, scale: 1.06 },
            {
                opacity: 1,
                scale: 1,
                duration: 1.5,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: "#foto-container",
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // TEXTO - sube suavemente
        gsap.fromTo(
            "#texto-nombres",
            { opacity: 0, y: 28 },
            {
                opacity: 1,
                y: 0,
                duration: 1.2,
                ease: "power2.out",
                delay: 0.4,
                scrollTrigger: {
                    trigger: "#texto-nombres",
                    start: "top 92%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // BOTÓN FLOTANTE PLAY/PAUSE
        const btnAudio = document.getElementById(
            "btn-audio-control",
        ) as HTMLButtonElement;
        const iconoPlay = document.getElementById("icono-play");
        const iconoPause = document.getElementById("icono-pause");

        const intervalo = setInterval(() => {
            const audio = (window as any).audioGlobal;
            if (audio) {
                clearInterval(intervalo);
                gsap.to(btnAudio, {
                    opacity: 1,
                    duration: 0.5,
                    ease: "power2.out",
                    onStart: () => {
                        btnAudio.style.pointerEvents = "auto";
                    },
                });
                iconoPlay?.classList.add("hidden");
                iconoPause?.classList.remove("hidden");

                btnAudio.addEventListener("click", () => {
                    const audioActual = (window as any).audioGlobal;
                    const reproduciendo = (window as any)
                        .estaReproduciendoGlobal;
                    if (!audioActual) return;
                    if (reproduciendo) {
                        audioActual.pause();
                        (window as any).estaReproduciendoGlobal = false;
                        iconoPause?.classList.add("hidden");
                        iconoPlay?.classList.remove("hidden");
                    } else {
                        audioActual.play();
                        (window as any).estaReproduciendoGlobal = true;
                        iconoPlay?.classList.add("hidden");
                        iconoPause?.classList.remove("hidden");
                    }
                    gsap.fromTo(
                        btnAudio,
                        { scale: 0.85 },
                        { scale: 1, duration: 0.3, ease: "back.out(2)" },
                    );
                });
            }
        }, 300);
    });
</script>

<style>
    /* Filtro para colorizar el icono de anillos en beige arena #B09372 */
    .anillo-salvia {
        filter: invert(73%) sepia(95%) saturate(151%) hue-rotate(340deg) brightness(69%);
    }
</style>
