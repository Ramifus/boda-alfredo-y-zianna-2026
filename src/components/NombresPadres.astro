---
// NombresPadres.astro
---

<section
    id="nombres-padres"
    class="relative w-full pt-2 pb-10 px-8 text-center overflow-hidden isolate"
>
    <!-- FLOR DECORATIVA DERECHA -->
    <img
        src="/imagenes/florcostado.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 right-0 w-40 pointer-events-none select-none opacity-30 scale-x-[-1] -translate-y-1/2 z-[-1]"
    />
    <!-- TÍTULO -->
    <p data-revelar="arriba" class="font-upcii uppercase text-2xl leading-snug text-[#B09372]">
        Con la bendición de Dios<br />y de nuestros padres
    </p>

    <!-- PADRES DEL NOVIO -->
    <div data-revelar="izquierda" class="mt-6">
        <p class="font-upcil text-2xl text-[#B09372]">PADRES DEL NOVIO</p>
        <p class="font-cormorant text-xl text-[#557E30] mt-1 leading-snug">
            Robert Fernández Durán
        </p>
        <p class="font-cormorant text-xl text-[#557E30] leading-snug">
            Yasmira Suárez Justiniano
        </p>
    </div>

    <!-- PADRES DE LA NOVIA -->
    <div data-revelar="derecha" class="mt-7">
        <p class="font-upcil text-2xl text-[#B09372]">PADRES DE LA NOVIA</p>
        <p class="font-cormorant text-xl text-[#557E30] mt-1 leading-snug">
            Jorge Alberto Cuéllar Suárez
        </p>
        <p class="font-cormorant text-xl text-[#557E30] leading-snug">
            Mónica Tardío Roth
        </p>
    </div>
</section>

