---
// Fecha.astro
---

<section
    id="fecha-boda"
    class="relative w-full pt-2 pb-12 px-6 text-center overflow-hidden isolate"
>
    <!-- HOJA DECORATIVA FONDO -->
    <img
        src="/imagenes/textura2.png"
        alt=""
        aria-hidden="true"
        class="absolute bottom-4 left-0 w-52 pointer-events-none select-none opacity-[0.06]"
    />

    <!-- FLOR DECORATIVA IZQUIERDA -->
    <img
        src="/imagenes/florcostado.png"
        alt=""
        aria-hidden="true"
        class="absolute top-[22%] left-0 w-40 pointer-events-none select-none opacity-30 z-[-1]"
    />

    <!-- FRASE SUPERIOR -->
    <p data-revelar="arriba" class="font-upcil uppercase text-2xl text-[#B09372] leading-[1.1]">
        Queremos que nos<br />acompañes en nuestro día
    </p>

    <!-- AÑO -->
    <p data-revelar="derecha" class="font-charm font-bold text-2xl text-[#B09372] mt-6 leading-none">
        2026
    </p>

    <!-- FILA FECHA: [Sábado entre líneas] | [31] | [Octubre entre líneas] -->
    <div data-revelar="izquierda" class="flex items-center justify-center gap-4 mt-3 px-2">
        <!-- Sábado con línea arriba y abajo -->
        <div class="flex flex-col items-center flex-1 gap-1">
            <div class="h-px w-full bg-[#D8C9B0] opacity-60"></div>
            <span
                class="font-cormorant text-2xl text-[#4E6B39] py-1 whitespace-nowrap"
            >
                Sábado
            </span>
            <div class="h-px w-full bg-[#D8C9B0] opacity-60"></div>
        </div>

        <!-- Caja del número día -->
        <div
            class="bg-white rounded-2xl px-5 py-3 shadow-md border border-[#D8C9B0] flex-shrink-0"
        >
            <span
                class="font-charm font-bold text-6xl text-[#B09372] leading-none"
                >31</span
            >
        </div>

        <!-- Octubre con línea arriba y abajo -->
        <div class="flex flex-col items-center flex-1 gap-1">
            <div class="h-px w-full bg-[#D8C9B0] opacity-60"></div>
            <span
                class="font-cormorant text-2xl text-[#4E6B39] py-1 whitespace-nowrap"
            >
                Octubre
            </span>
            <div class="h-px w-full bg-[#D8C9B0] opacity-60"></div>
        </div>
    </div>

    <!-- DÍA DE LA SEMANA -->
    <p data-revelar="derecha" class="font-charm font-bold text-2xl text-[#B09372] mt-5">19:00 horas</p>

    <!-- ICONO CALENDARIO CON CORAZÓN -->
    <div data-revelar="centro" class="flex justify-center mt-4">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 42 42"
            fill="none"
            class="w-10 h-10"
        >
            <rect
                x="3"
                y="8"
                width="36"
                height="30"
                rx="5"
                stroke="#D8C9B0"
                stroke-width="1.4"></rect>
            <line
                x1="3"
                y1="17"
                x2="39"
                y2="17"
                stroke="#D8C9B0"
                stroke-width="1.4"></line>
            <line
                x1="13"
                y1="3"
                x2="13"
                y2="12"
                stroke="#D8C9B0"
                stroke-width="1.6"
                stroke-linecap="round"></line>
            <line
                x1="29"
                y1="3"
                x2="29"
                y2="12"
                stroke="#D8C9B0"
                stroke-width="1.6"
                stroke-linecap="round"></line>
            <path
                d="M21 31 C21 31 14.5 26.8 14.5 23 C14.5 21.1 16 20 17.8 20 C19.2 20 20.3 20.8 21 22 C21.7 20.8 22.8 20 24.2 20 C26 20 27.5 21.1 27.5 23 C27.5 26.8 21 31 21 31Z"
                fill="#B09372"></path>
        </svg>
    </div>

    <!-- ESPACIO antes de Faltan -->
    <div class="mt-10"></div>

    <!-- FALTAN -->
    <p data-revelar="izquierda" class="font-great-vibes text-5xl text-[#557E30] leading-none">Faltan</p>

    <!-- CARD DEL CONTADOR -->
    <div
        data-revelar="abajo"
        class="mt-5 mx-2 bg-white/80 rounded-2xl py-5 px-4 shadow-sm border border-[#e8e0d0]"
    >
        <div class="flex justify-around">
            <div class="flex flex-col items-center">
                <span
                    id="countdown-days"
                    class="font-charm font-bold text-4xl text-[#B09372] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-base text-[#557E30] mt-1"
                    >Días</span
                >
            </div>

            <div class="flex flex-col items-center">
                <span
                    id="countdown-hours"
                    class="font-charm font-bold text-4xl text-[#B09372] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-sm text-[#557E30] mt-1"
                    >Hrs.</span
                >
            </div>

            <div class="flex flex-col items-center">
                <span
                    id="countdown-minutes"
                    class="font-charm font-bold text-4xl text-[#B09372] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-sm text-[#557E30] mt-1"
                    >Min.</span
                >
            </div>

            <div class="flex flex-col items-center">
                <span
                    id="countdown-seconds"
                    class="font-charm font-bold text-4xl text-[#B09372] leading-none"
                    >00</span
                >
                <span class="font-cormorant text-sm text-[#557E30] mt-1"
                    >S.</span
                >
            </div>
        </div>
    </div>
</section>

<script>
    // ── FECHA DE LA BODA (ajustar aquí) ──────
    const FECHA_BODA = new Date("2026-10-31T19:00:00");
    // ──────────────────────────────────────────

    function pad(n: number): string {
        return String(n).padStart(2, "0");
    }

    function actualizar() {
        const diff = FECHA_BODA.getTime() - Date.now();

        const dEl = document.getElementById("countdown-days");
        const hEl = document.getElementById("countdown-hours");
        const mEl = document.getElementById("countdown-minutes");
        const sEl = document.getElementById("countdown-seconds");

        if (diff <= 0) {
            [dEl, hEl, mEl, sEl].forEach((el) => {
                if (el) el.textContent = "00";
            });
            return;
        }

        if (dEl) dEl.textContent = pad(Math.floor(diff / 86400000));
        if (hEl) hEl.textContent = pad(Math.floor((diff % 86400000) / 3600000));
        if (mEl) mEl.textContent = pad(Math.floor((diff % 3600000) / 60000));
        if (sEl) sEl.textContent = pad(Math.floor((diff % 60000) / 1000));
    }

    actualizar();
    setInterval(actualizar, 1000);
</script>
